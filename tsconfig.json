{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ],
    "jsxImportSource": "preact",
    "paths": {
      "react": [
        "./node_modules/preact/compat/"
      ],
      "react-dom": [
        "./node_modules/preact/compat/"
      ],
      "react-dom/client": [
        "./node_modules/preact/compat/client"
      ],
      "react/jsx-runtime": [
        "./node_modules/preact/jsx-runtime"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts"
  ]
}